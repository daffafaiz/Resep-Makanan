<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_toolbar" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_kotak_tinggi"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/koleksi_dapur"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tambah_resep_baru"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_tambah"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                style="@style/Kartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/judul_resep"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvJumlahKarakter"
                        style="@style/TeksKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etJudul"
                    style="@style/Masukan"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:autofillHints="no"
                    android:hint="@string/petunjuk_judul"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <TextView
                    style="@style/TeksKecil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/sub_judul" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardKategori"
                style="@style/Kartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/pilihan_kategori"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/katSarapan"
                        style="@style/PilihanKategori" />

                    <TextView
                        android:id="@+id/katUtama"
                        style="@style/PilihanKategori" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/katCamilan"
                        style="@style/PilihanKategori" />

                    <TextView
                        android:id="@+id/katMinuman"
                        style="@style/PilihanKategori" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvErrorKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/err_kategori"
                    android:textColor="@color/error"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Kartu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:minHeight="26dp"
                        android:text="@string/porsi_dasar_wajib"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnKurangPorsi"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/kurangi"
                            android:src="@drawable/ic_remove" />

                        <EditText
                            android:id="@+id/etPorsi"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:autofillHints="no"
                            android:background="@null"
                            android:gravity="center"
                            android:hint="@string/porsi_awal_nilai"
                            android:inputType="number"
                            android:maxLines="1"
                            android:text="@string/porsi_awal_nilai"
                            android:textColor="@color/primary"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnTambahPorsi"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackground"
                            android:contentDescription="@string/tambahi"
                            android:src="@drawable/ic_add_gelap" />
                    </LinearLayout>

                    <TextView
                        style="@style/TeksKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/batas_porsi" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Kartu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:minHeight="26dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/waktu_wajib"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLabelWaktu"
                            style="@style/Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etWaktu"
                        style="@style/Masukan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:autofillHints="no"
                        android:inputType="number"
                        android:maxLines="1" />

                    <TextView
                        style="@style/TeksKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/batas_waktu" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Kartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Judul"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bahan_wajib" />

                    <TextView
                        android:id="@+id/tvJumlahBaris"
                        style="@style/TeksKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    style="@style/TeksKecil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sub_bahan" />

                <LinearLayout
                    android:id="@+id/listInputBahan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTambahBahan"
                    style="@style/TombolKedua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tambah_bahan_lain"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <LinearLayout
                style="@style/Kartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Judul"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/langkah_wajib" />

                    <TextView
                        android:id="@+id/tvJumlahLangkah"
                        style="@style/TeksKecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    style="@style/TeksKecil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/sub_langkah" />

                <LinearLayout
                    android:id="@+id/listInputLangkah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTambahLangkah"
                    style="@style/TombolKedua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tambah_langkah"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatal"
                    style="@style/TombolKedua"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/batal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimpan"
                    style="@style/TombolUtama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/simpan_resep" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
